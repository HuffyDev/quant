# ─────────────────────────────────────────────────────────────────────────────
# Baby Brain — environment. On Replit put these in Secrets (Tools → Secrets),
# NOT in a committed file. See SETUP.md for where to get each one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────
MODE=sim                       # sim | live
SIM_SPEED=10                   # sim only: development speed (10 = first hour in 6 real min). Clocks show real time.
# LLM_PROVIDER=anthropic       # anthropic (default) | mock (keyless local testing only; refused in live)
# LLM_MODEL_MAIN=claude-sonnet-5-5
# LLM_MODEL_CHEAP=claude-haiku-5-5

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=                  # set automatically when you add Replit PostgreSQL
ADMIN_TOKEN=CHANGE_ME_long_random_string   # protects /admin and /admin/api/*
# PORT=5000
# TRUST_PROXY_HOPS=1           # reverse proxies in front of the app (Replit = 1)

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── X (Twitter) API v2, pay-per-use ──────────────────────────────────────────
X_API_KEY=REPLACE_ME
X_API_SECRET=REPLACE_ME
X_ACCESS_TOKEN=REPLACE_ME      # user-context token for the Baby account (Read + Write)
X_ACCESS_SECRET=REPLACE_ME
X_BEARER_TOKEN=REPLACE_ME      # app-only token, used for reading mentions
X_BOT_USER_ID=REPLACE_ME       # optional fallback — at startup the id comes from GET /2/users/me (warns if different)
X_BOT_HANDLE=REPLACE_ME        # optional fallback — handle without @, also verified via /2/users/me
X_DAILY_BUDGET_USD=5           # hard daily cap; calls are refused beyond it
X_COST_POST_USD=0.015          # per-call cost estimates (USD) used for the daily budget
X_COST_READ_USD=0.005
# X_WRITES_DISABLED=true       # live test mode: read X but never post
# THOUGHT_POSTS_ENABLED=true   # short "growing up" tweets from birth
# THOUGHT_POST_MIN_S=30        # random interval between thought posts (seconds)
# THOUGHT_POST_MAX_S=120
# MIN_SECONDS_BETWEEN_REPLIES=60

# ── Solana / market data ─────────────────────────────────────────────────────
HELIUS_API_KEY=REPLACE_ME
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
BIRDEYE_API_KEY=               # optional, not used in v1
PUMPPORTAL_API_KEY=            # optional (local trade API needs none; may be required for PumpSwap trade data)
JUPITER_API_KEY=REPLACE_ME     # needed after the token migrates off the bonding curve

# ── Token / launch (can also be set from /admin) ─────────────────────────────
TOKEN_MINT=                    # set at launch
TOKEN_NAME=Baby Brain
TOKEN_SYMBOL=BRAIN
LAUNCH_TIMESTAMP=              # ISO UTC, e.g. 2026-10-10T18:00:00Z (T+0)

# ── Treasury ─────────────────────────────────────────────────────────────────
TREASURY_PUBKEY=REPLACE_ME
TREASURY_PRIVATE_KEY=REPLACE_ME   # base58. ONLY read by server/services/adapters/live/executor.ts

# ── Guardian limits (optional overrides; defaults shown) ─────────────────────
# MAX_BUYBACK_SOL_PER_TX=0.5
# MAX_SPEND_SOL_PER_HOUR=2.0
# MAX_SPEND_SOL_PER_DAY=5.0
# MIN_TREASURY_RESERVE_SOL=3.0
# MIN_SECONDS_BETWEEN_BUYBACKS=240
# MAX_SLIPPAGE_BPS=500
# FIRST_BUYBACK_SOL=0.2
